						</div>

						<!-- Register -->
						<div id="register-section" class="d-none">
							<div class="form-group position-relative">
								<label class="sr-only" for="otp-register-fname">First Name</label>
								<input type="text" class="form-control form-control-icon" id="otp-register-fname" placeholder="Enter First Name" maxlength="25">
								<i class="fas fa-user placholder-icon"></i>
							</div>
							<div class="form-group position-relative">
								<label class="sr-only" for="otp-register-lname">Last Name</label>
								<input type="text" class="form-control form-control-icon" id="otp-register-lname" placeholder="Enter Last Name" maxlength="25">
								<i class="fas fa-user placholder-icon"></i>
							</div>
							<div class="form-group position-relative">
								<label class="sr-only" for="otp-register-email">Email address</label>
								<input type="email" class="form-control form-control-icon" id="otp-register-email" placeholder="Enter Email address" maxlength="64">
								<i class="fas fa-envelope-open placholder-icon"></i>
							</div>
							<div class="text-center text-muted py-2">
								By pressing “submit” you agree to our<br />
								<a href="./">terms & conditions</a>
							</div>
							<div id="otp-login-register-alert"></div>
							<button type="submit" class="btn btn-primary btn-block my-3" id="otp-register-btn" onclick="registerUser()">Submit</button>
						</div>
					</form>

				</div>
			</div>
		</div>
	</div>
</div>
		<!-- Modal -->
<div class="modal fade" id="agent-login" data-backdrop="static" data-keyboard="false" tabindex="-1" aria-labelledby="agent-login-label" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="agent-login-label">Office / Agent Login</h5>
				<button type="button" class="close" data-dismiss="modal" id="close-login-btn" aria-label="Close">
					<span aria-hidden="true">&times;</span>
				</button>
			</div>
			<div class="modal-body">
				<form id="agent-login-form" onsubmit="doAgentLogin(event)">
					<div class="form-group">
						<label for="agent-login-username">Username</label>
						<input type="text" class="form-control" id="agent-login-username" placeholder="Enter Username" maxlength="45">
					</div>
					<div class="form-group">
						<label for="agent-login-password">Password</label>
						<input type="password" class="form-control" id="agent-login-password" placeholder="Enter Password" maxlength="30" autocomplete="off">
						<!-- <input type="hidden" class="form-control" id="mobile-number-field" placeholder="" maxlength="30"> -->
					</div>
					<div class="form-group" id="otp-section-two" style="display: none;">           
						<label for="agent-login-otps">OTP</label>
						<input type="text" class="form-control" id="agent-login-otps" placeholder="Enter OTP" maxlength="6"  autocomplete="off">
					</div>
					<div id="agent-login-alert"></div>
					<button type="submit" class="btn btn-primary btn-block my-4" id="agent-login-btn">Login</button>
					<button type="button" class="btn btn-success btn-block my-4" id="otp-verify-btn" style="display: none;" onclick="verifyOtpNumber()">Verify OTP</button>
					<button type="button" class="btn btn-success btn-block my-4" id="otp-verifyed-btn" style="display: none;" onclick="verifyedUserNumber()">Verify OTP</button>
				</form>
			</div>
		</div>
	</div>
</div>
<script>
	$(document).ready(function() {
	    $('#close-login-btn').click(function() {
	        $('#otp-section-two').hide();
	        $('#agent-login-alert').hide();
	        $('#otp-verify-btn').hide();
			$('#otp-verifyed-btn').hide();
	        $('#agent-login-btn').show();
			$('#agent-login-password').removeClass('is-invalid');
			$('#agent-login-username').removeClass('is-invalid');
			$('#agent-login-username').val('').prop('readonly', false);
			$('#agent-login-password').val('').prop('readonly', false);
			$('#agent-login-btn').text('Login').attr('disabled', false);
	    });
	});
</script>

